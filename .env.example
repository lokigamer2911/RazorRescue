# RazorRescue Environment Configuration

# OpenRouter API Key — the pipeline only ever calls :free endpoints
# (hard guard: paid models are refused unless ALLOW_PAID_MODELS=true).
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Neon.tech PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/razorrescue?sslmode=require

# Firebase project id — required to verify Firebase ID tokens on gateway routes
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: explicit key for AES-256-GCM encryption of gateway credentials.
# If unset, a key is derived from DATABASE_URL.
GATEWAY_ENC_KEY=replace-with-a-long-random-string

# Server Configuration
PORT=3001
NODE_ENV=development

# Comma-separated CORS whitelist (no wildcard)
ALLOWED_ORIGINS=http://localhost:5173,https://razorrescue.vercel.app