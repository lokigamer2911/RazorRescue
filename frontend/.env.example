# ─── Firebase Auth configuration ─────────────────────────────────────────────
# Copy this file to frontend/.env and fill in the values from your Firebase
# project (Firebase Console → Project settings → Your apps → Web app → SDK setup).
# NEVER commit frontend/.env — it is gitignored.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
# Optional — only needed if you later use Storage / Messaging:
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890